  <keyword>morse.isvalid</keyword>
  <short_description>Tester si une chaine est du code Morse decodable.</short_description>
  <syntax>
    <syntax_item>tf = morse.isvalid(code)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>code</param_name>
      <param_description>un vecteur ligne de caracteres ou une chaine scalaire.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>un scalaire logique.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Vrai lorsque <b>code</b> est une chaine Morse non vide composee uniquement de points, traits, espaces de lettre et barres de mot, dont chaque groupe points/traits correspond a un caractere de la table.</p>
  </description>
  <used_function />
