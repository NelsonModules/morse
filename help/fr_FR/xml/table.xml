  <language>fr_FR</language>
  <keyword>morse.table</keyword>
  <short_description>La table du code Morse international.</short_description>
  <syntax>
    <syntax_item>morse.table()</syntax_item>
    <syntax_item>t = morse.table()</syntax_item>
  </syntax>
  <param_input />
  <param_output>
    <param_output_item>
      <param_name>t</param_name>
      <param_description>un tableau cellulaire N-par-2 ; colonne 1 chaque caractere, colonne 2 son code points/traits.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Sans sortie, affiche la table groupee en lettres, chiffres et ponctuation. Avec une sortie, la renvoie comme tableau cellulaire, par exemple t{1, :} vaut {'A', '.-'}.</p>
  </description>
  <used_function />
  <bibliography>Recommandation ITU-R M.1677-1, code Morse international.</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[morse.table()
t = morse.table();
t(1:5, :)]]></example_item_data>
    </example_item>
  </examples>
