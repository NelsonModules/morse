  <language>en_US</language>
  <keyword>morse.towav</keyword>
  <short_description>Write a message as Morse code to a WAV file.</short_description>
  <syntax>
    <syntax_item>morse.towav(filename, input)</syntax_item>
    <syntax_item>morse.towav(filename, input, name, value)</syntax_item>
    <syntax_item>[y, fs] = morse.towav(filename, input, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>filename</param_name>
      <param_description>the path of the WAV file to write.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>input</param_name>
      <param_description>a character row vector or scalar string: plain text or a Morse code string.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>name, value</param_name>
      <param_description>any option of <b>morse.tone</b> (WPM, Farnsworth, Frequency, SampleRate, Amplitude, RampMs, Input).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>y</param_name>
      <param_description>the samples that were written (column vector).</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>fs</param_name>
      <param_description>the sample rate in hertz.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Synthesizes the audio with <b>morse.tone</b> and writes it to <b>filename</b> with <b>audiowrite</b>, so it can be shared or played later without Nelson.</p>
  </description>
  <used_function>
    <used_function_item>audiowrite</used_function_item>
  </used_function>
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[morse.towav([tempdir(), 'sos.wav'], 'SOS', 'WPM', 18)]]></example_item_data>
    </example_item>
  </examples>
