  <keyword>morse.isvalid</keyword>
  <short_description>Test whether a string is decodable Morse code.</short_description>
  <syntax>
    <syntax_item>tf = morse.isvalid(code)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>code</param_name>
      <param_description>a character row vector or scalar string.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>a logical scalar.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>True when <b>code</b> is a non-empty Morse string made only of dots, dashes, letter spaces and word slashes in which every dot/dash group matches a character in the table.</p>
  </description>
  <used_function />
